# === Application ===
PROJECT_NAME="Corporate Benefits Platform"
DEBUG=true
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost
CORS_ORIGINS=http://localhost,http://localhost:3000

# === PostgreSQL ===
POSTGRES_DB=benefits
POSTGRES_USER=benefits_user
POSTGRES_PASSWORD=benefits_pass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === JWT ===
JWT_SECRET=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# === Ollama / AI ===
AI_ENABLED=true
OLLAMA_HOST=http://ollama:11434
OLLAMA_API_KEY=
# Cloud model (requires OLLAMA_API_KEY from Ollama Cloud):
OLLAMA_MODEL=gemma2:9b-instruct-q8_0
OLLAMA_IS_CLOUD=false
OLLAMA_TIMEOUT_SECONDS=60

# === Demo Data ===
SEED_DEMO_DATA=true
DEMO_PASSWORD=Demo1234!

# === Rate Limiting ===
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_AI=15
RATE_LIMIT_BENEFITS=50
RATE_LIMIT_REDEMPTIONS=20
