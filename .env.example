# Скопировать в .env и заполнить. Имена переменных должны совпадать с полями
# backend/app/core/config.py::Settings — иначе значение молча игнорируется.

# === Приложение ===
PROJECT_NAME="Corporate Benefits Platform"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost
CORS_ORIGINS=http://localhost,http://localhost:3000
NGINX_PORT=80

# === PostgreSQL ===
POSTGRES_DB=benefits
POSTGRES_USER=benefits_user
POSTGRES_PASSWORD=benefits_pass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# === Redis ===
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# === JWT ===
# Обязательно задать своё значение: compose откажется стартовать без JWT_SECRET.
JWT_SECRET=change-this-to-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# === Ollama / AI ===
AI_ENABLED=true
# Host systemd Ollama service (use host.docker.internal from container):
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma2:9b
OLLAMA_TIMEOUT_SECONDS=30

# === Демо-данные ===
SEED_DEMO_DATA=true
DEMO_PASSWORD=Demo1234!

# === Ограничение частоты запросов ===
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_AI=15
RATE_LIMIT_BENEFITS=60
RATE_LIMIT_REDEMPTIONS=10

# === Домен ===
PROMO_CODE_DEFAULT_VALID_DAYS=30
INVITE_TOKEN_EXPIRE_DAYS=7
SSE_TICKET_TTL_SECONDS=60

# === Telegram-бот проверки промокодов ===
# TELEGRAM_BOT_TOKEN — выдаётся @BotFather при создании бота.
# BOT_API_KEY — общий секрет между ботом и backend. Придумайте случайную строку,
# например: openssl rand -hex 32
# Пустой BOT_API_KEY закрывает эндпоинт /api/v1/bot/promo/{code} полностью.
TELEGRAM_BOT_TOKEN=
BOT_API_KEY=
