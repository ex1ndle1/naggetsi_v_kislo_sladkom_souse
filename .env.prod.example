# === Production environment (Cloudflare Tunnel) ===
# Скопировать в .env.prod на production сервере

# === Приложение ===
PROJECT_NAME="Наггетсы30"
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
# CORS временно отключён в docker-compose.prod.yml через CORS_ORIGINS="*".
# После определения публичного hostname верните ограничение на конкретный origin.
CORS_ORIGINS=*

# === Nginx ===
# Cloudflared обращается к nginx внутри Docker-сети.
NGINX_PORT=8080

# === Cloudflare Tunnel ===
# Создайте Tunnel в Cloudflare Zero Trust и вставьте его токен.
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_THIS_TO_CLOUDFLARE_TUNNEL_TOKEN

# === PostgreSQL ===
POSTGRES_DB=benefits_prod
POSTGRES_USER=benefits_prod_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === JWT ===
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# === Ollama / AI (опционально) ===
AI_ENABLED=true
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=gemma2:9b
OLLAMA_TIMEOUT_SECONDS=30

# === Telegram-бот ===
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
BOT_API_KEY=YOUR_RANDOM_API_KEY_32_CHARS

# === Rate Limiting ===
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_AI=15
RATE_LIMIT_BENEFITS=60
RATE_LIMIT_REDEMPTIONS=10

# === Домен ===
PROMO_CODE_DEFAULT_VALID_DAYS=30
INVITE_TOKEN_EXPIRE_DAYS=7
SSE_TICKET_TTL_SECONDS=60
