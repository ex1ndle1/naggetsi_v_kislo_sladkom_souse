# Production configuration

# Database
POSTGRES_DB=benefits_prod
POSTGRES_USER=benefits_prod
POSTGRES_PASSWORD=  # REQUIRED: use strong password

# Security
JWT_SECRET=  # REQUIRED: openssl rand -hex 32
BOT_API_KEY=  # REQUIRED: openssl rand -hex 32

# CORS
CORS_ORIGINS=https://yourdomain.com

# AI (optional)
OLLAMA_HOST=https://your-ollama-host.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
AI_ENABLED=true

# Telegram
TELEGRAM_BOT_TOKEN=
BOT_API_KEY=

# Nginx
NGINX_PORT=80

# Rate limits
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_AI=15
